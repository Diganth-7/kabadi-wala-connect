# ------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.
# ------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# (the "+psycopg" tells SQLAlchemy to use the psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/kabadiwala_connect

# JWT settings
JWT_SECRET_KEY=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# App environment: "development" or "production"
ENVIRONMENT=development
