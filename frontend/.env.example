# --- Local development only ---
# When frontend and backend run as separate dev servers (npm run dev +
# uvicorn --reload), point the frontend at the backend's own port.
# Copy this to .env.development for local dev.
#
# For PRODUCTION single-URL deployment (FastAPI serving the built
# frontend), leave this unset — api.ts automatically falls back to a
# relative "/api" path since both are served from the same origin.
VITE_API_BASE_URL=http://localhost:8000/api
